<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence 
	https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
	version="3.1">
	<!-- Se puede ignorar los errores de arriba en caso de que diga algo de DownloadResourceDisabled -->
	<persistence-unit name="clasePU">
		<!-- Aquí tenemos que listar todas las clases que usemos -->
		<class>model.customers</class>
		<class>model.employees</class>
		<class>model.offices</class>
		<class>model.orderdetails</class>
		<class>model.orders</class>
		<class>model.payments</class>
		<class>model.productlines</class>
		<class>model.products</class>
		<properties>
			<property name="jakarta.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/classicmodels" />
			<property name="jakarta.persistence.jdbc.user" value="alumno" />
			<property name="jakarta.persistence.jdbc.password" value="123" />
			<!-- Crea/actualiza las tablas a partir de las entidades -->
			<property name="hibernate.hbm2ddl.auto" value="update" />
			<!-- Muestra el SQL que genera Hibernate -->
			<property name="hibernate.show_sql" value="false" />
			<property name="hibernate.format_sql" value="true" />
		</properties>
	</persistence-unit>
</persistence>