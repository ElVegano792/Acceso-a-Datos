<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
	version="3.2">
	<persistence-unit name="clasePU">
		<class>com.dam2.goya.Producto</class>
		<properties>
			<property name="jakarta.persistence.jdbc.url"
				value="jdbc:mysql://localhost:3306/dam2jpa?createDatabaseIfNotExist=true" />
			<property name="jakarta.persistence.jdbc.user" value="alumno" />
			<property name="jakarta.persistence.jdbc.password" value="123" />
			<!-- Crea/actualiza las tablas a partir de las entidades -->
			<property name="hibernate.hbm2ddl.auto" value="update" />
			<!-- Muestra el SQL que genera Hibernate -->
			<property name="hibernate.show_sql" value="false" />
<!--			El hibernate.show_sql = false es para decir que no muestre las secuencias ejecutadas -->
<!--			<property name="hibernate.show_sql" value="true" />-->
			<property name="hibernate.format_sql" value="true" />
		</properties>
	</persistence-unit>
</persistence>